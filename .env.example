NODE_ENV=development
AUTH_MODE=development
AUTH_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_DAYS=30
PORT=3000
WEB_PORT=5173
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/m2m.sqlite
MEDIA_STORAGE_PATH=./data/media

# ComfyUI local video generation
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Keep false in normal use. When true, an offline ComfyUI returns a public demo MP4,
# not an AI-generated video.
COMFYUI_ENABLE_VIDEO_FALLBACK=false
REDIS_URL=redis://127.0.0.1:6379
MASTER_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
APP_URL=http://localhost:5173
WEBHOOK_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
INTERNAL_API_BASE_URL=http://127.0.0.1:3000
WORKFLOW_TIMEOUT_MS=300000
NODE_TIMEOUT_MS=60000
WEBHOOK_RESPONSE_TIMEOUT_MS=55000
EXECUTION_RETENTION_DAYS=30
BACKUP_DIRECTORY=./backups
