{
  "name": "@m2m/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts",
