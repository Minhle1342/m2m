    "db:backup": "tsx src/backup.ts"
  },
  "dependencies": {
    "@m2m/shared": "workspace:*",
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "reflect-metadata": "latest",
    "typeorm": "latest"
  },
  "devDependencies": { "tsx": "latest" }
}
